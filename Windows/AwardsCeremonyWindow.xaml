<Window x:Class="Scoreboard.Windows.AwardsCeremonyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="BHL Scoreboard — Awards Ceremony"
        Background="#0a0f1c"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="🏆 AWARDS CEREMONY 🏆"
                       Foreground="#e8b34c"
                       FontSize="64"
                       FontWeight="Bold"
                       FontFamily="Garamond"
                       HorizontalAlignment="Center"
                       Margin="0,50,0,0" />

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Champion -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Image Source="{Binding ChampionLogo}" Width="130" Height="130" Margin="0,0,30,0"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChampionLogo}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel>
                        <TextBlock Text="🥇 CHAMPION" Foreground="#e8b34c" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="{Binding Champion}" Foreground="White" FontSize="80" FontWeight="Bold" FontFamily="Garamond" />
                    </StackPanel>
                </StackPanel>

                <!-- Runner-up -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Image Source="{Binding RunnerUpLogo}" Width="90" Height="90" Margin="0,0,24,0"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RunnerUpLogo}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel>
                        <TextBlock Text="🥈 RUNNER-UP" Foreground="#c3cddd" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{Binding RunnerUp}" Foreground="#e6e6e6" FontSize="52" FontWeight="Bold" FontFamily="Garamond" />
                    </StackPanel>
                </StackPanel>

                <!-- 3rd place — collapsed entirely if it couldn't be determined -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10"
                            Visibility="{Binding HasThirdPlace, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="🥉 3RD PLACE" Foreground="#cd7f32" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ThirdPlaceText}" Foreground="#cccccc" FontSize="36" FontWeight="Bold" FontFamily="Garamond" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Custom trophies — collapsed entirely if none entered for this event -->
                <ItemsControl ItemsSource="{Binding Trophies}"
                              Margin="0,20,0,0"
                              Visibility="{Binding HasTrophies, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Margin="0,4" FontSize="24" Foreground="#e6e6e6">
                                <Run Text="🏆 " />
                                <Run Text="{Binding AwardName}" FontWeight="Bold" Foreground="#e8b34c" />
                                <Run Text=" — " />
                                <Run Text="{Binding TeamName}" FontWeight="Bold" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="Press Esc to close"
                       Foreground="#666666"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30" />
        </Grid>
    </Viewbox>
</Window>
