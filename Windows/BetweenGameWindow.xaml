<Window x:Class="Scoreboard.Windows.BetweenGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:Scoreboard.Helpers"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="BHL Scoreboard"
        Background="#E6000000"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True">
    <Window.Resources>
        <h:EqualsVisibilityConverter x:Key="EqualsVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="AttractTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e8b34c" />
            <Setter Property="FontSize" Value="46" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,28" />
        </Style>
        <!-- Text-body panels (What is Bot Hockey) — hidden when the panel is list-based -->
        <Style x:Key="AttractBody" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#dddddd" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="44" />
            <Setter Property="TextAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- One line of an attract panel: team logo + text, or (for matchup rows,
             e.g. Upcoming Matches) logo + "TeamA vs TeamB" + a second logo. Logo2
             is null everywhere else, so it just stays collapsed. -->
        <DataTemplate x:Key="AttractItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,6">
                <Image Source="{Binding Logo}"
                       Height="50" Width="50"
                       Margin="0,0,18,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Logo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock Text="{Binding Text}"
                           Foreground="#e6e6e6"
                           FontSize="36"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="460" />
                <Image Source="{Binding Logo2}"
                       Height="50" Width="50"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Logo2}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
    <Grid Width="1920" Height="1080">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Matches the 3-way split the attract panels/countdown use, so the left
             and right panels can span both the logo row and the content row below
             it (RowSpan="2") — the logo only actually occupies the center column,
             so that space beside it was otherwise going unused. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Logo -->
        <Image Grid.Row="0" Grid.Column="1"
               Source="pack://application:,,,/Resources/BHLOfficialLogo-1.png"
               Height="170"
               HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Margin="0,16,0,0" />

        <!-- Left: attract carousel (panels enter here, shift right next tick). Spans
             the logo row too, reaching all the way to the top of the screen — that
             space beside the logo was unused. Fixed-height viewport; content taller
             than that slowly auto-scrolls (see code-behind) since nothing here is
             interactive. ScrollViewer tracks its own scrollable height natively, and
             centers content that's shorter than the viewport via VerticalContentAlignment. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="40,0,0,0"
              Visibility="{Binding HasAttract, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer x:Name="LeftAttractScroll" Height="820"
                          HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          IsHitTestVisible="False" Focusable="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                    <TextBlock Text="{Binding CurrentLeft.Title}" Style="{StaticResource AttractTitle}" />
                    <ItemsControl ItemsSource="{Binding CurrentLeft.Items}"
                                  ItemTemplate="{StaticResource AttractItemTemplate}" />
                    <TextBlock Text="{Binding CurrentLeft.Body}"
                               Style="{StaticResource AttractBody}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Center: Next match countdown -->
        <StackPanel Grid.Row="1" Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <!-- Next Up (hidden when empty) -->
                <TextBlock Text="NEXT UP"
                           Foreground="#AAAAAA"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NextUpDisplay}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Viewbox Stretch="Uniform"
                         StretchDirection="DownOnly"
                         MaxWidth="580"
                         Margin="0,0,0,28">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NextUpDisplay}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <TextBlock Text="{Binding NextUpDisplay}"
                               Foreground="White"
                               FontSize="42"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextWrapping="NoWrap" />
                </Viewbox>

                <TextBlock Text="NEXT MATCH IN"
                           Foreground="#AAAAAA"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Foreground="White"
                           FontSize="220"
                           FontWeight="Bold"
                           HorizontalAlignment="Center">
                    <TextBlock.Text>
                        <Binding Path="NextMatchTime">
                            <Binding.Converter>
                                <h:TimeSpanConverter />
                            </Binding.Converter>
                        </Binding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="{Binding StartsAtDisplay}"
                           Foreground="#CCCCCC"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
                <TextBlock Text="{Binding PaceWarningText}"
                           Foreground="#e8b34c"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="480"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PaceWarningText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Foreground="#666666"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Rotate dial to adjust · Press to start" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCountingDown}" Value="True">
                                    <Setter Property="Text" Value="Rotate dial to add time" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

        <!-- Right: attract carousel (shows the panel that was on the left last tick).
             Spans the logo row too, same as Left. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,40,0"
              Visibility="{Binding HasAttract, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer x:Name="RightAttractScroll" Height="820"
                          HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          IsHitTestVisible="False" Focusable="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                    <TextBlock Text="{Binding CurrentRight.Title}" Style="{StaticResource AttractTitle}" />
                    <ItemsControl ItemsSource="{Binding CurrentRight.Items}"
                                  ItemTemplate="{StaticResource AttractItemTemplate}" />
                    <TextBlock Text="{Binding CurrentRight.Body}"
                               Style="{StaticResource AttractBody}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom bar: QR codes always visible -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="60,0,60,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Image Source="{Binding BracketQRCode}"
                       Width="190" Height="190"
                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BracketQRCode}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="BRACKET"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold" />
                    <TextBlock Text="scan to follow along"
                               Foreground="#888888"
                               FontSize="18" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0" HorizontalAlignment="Right">
                    <TextBlock Text="LEARN MORE!"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"
                               TextAlignment="Right" />
                    <TextBlock Text="teams · stats · league history"
                               Foreground="#888888"
                               FontSize="18"
                               TextAlignment="Right" />
                </StackPanel>
                <Image Source="{Binding LearnMoreQRCode}"
                       Width="190" Height="190"
                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LearnMoreQRCode}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </StackPanel>
        </Grid>
    </Grid>
    </Viewbox>
</Window>
