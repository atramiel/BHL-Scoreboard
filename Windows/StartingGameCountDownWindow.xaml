<Window x:Class="Scoreboard.Windows.StartingGameCountDownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scoreboard.ViewModels"
        xmlns:h="clr-namespace:Scoreboard.Helpers"
        mc:Ignorable="d"
        Topmost="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Icon="../Resources/appIcon.ico"
        ResizeMode="NoResize"
        Title="StartingGameCountDownWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:StartingGameCountDownViewModel />
    </Window.DataContext>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding StartCountDownCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border CornerRadius="16">
        <Border.Background>
            <SolidColorBrush Color="#0d0d1a" />
        </Border.Background>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- Smooth color journey: midnight -> electric blue -> violet -> teal -> back -->
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard Name="ColorCycle">
                            <Storyboard RepeatBehavior="Forever">
                                <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="Background.Color">
                                    <EasingColorKeyFrame KeyTime="0:0:0"   Value="#0d0d1a" />
                                    <EasingColorKeyFrame KeyTime="0:0:1"   Value="#1c55c0" />
                                    <EasingColorKeyFrame KeyTime="0:0:2"   Value="#5a1ea8" />
                                    <EasingColorKeyFrame KeyTime="0:0:3"   Value="#0d7a8a" />
                                    <EasingColorKeyFrame KeyTime="0:0:4"   Value="#0d0d1a" />
                                </ColorAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <!-- Final three: the journey ends, everything turns urgent red -->
                    <DataTrigger Binding="{Binding IsFinalThree}" Value="True">
                        <DataTrigger.EnterActions>
                            <StopStoryboard BeginStoryboardName="ColorCycle" />
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                    From="#3a0712" To="#c0142e"
                                                    Duration="0:0:0.5" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Shrink-to-fit: the window is a fixed 800x450, so "GAME OVER" must
                 scale down to stay inside it; digits already fit, so DownOnly
                 leaves their size untouched. -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Width="740" Height="380">
            <Label HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Background="Transparent"
                   FontSize="240"
                   FontWeight="Bold"
                   FontFamily="Garamond"
                   HorizontalContentAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
                <Label.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Label.RenderTransform>
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#7db8e8" BlurRadius="45" ShadowDepth="0" Opacity="0.95" />
                            </Setter.Value>
                        </Setter>
                        <!-- Default content: the ticking clock -->
                        <Setter Property="Content">
                            <Setter.Value>
                                <Binding Path="Clock">
                                    <Binding.Converter>
                                        <h:TimeSpanConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFinalThree}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#ff2444" BlurRadius="55" ShadowDepth="0" Opacity="1" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <!-- Pop the number on every tick (IsAlternateColor flips each second) -->
                            <DataTrigger Binding="{Binding IsAlternateColor}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             From="1.22" To="1" Duration="0:0:0.28" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             From="1.22" To="1" Duration="0:0:0.28" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlternateColor}" Value="False">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             From="1.22" To="1" Duration="0:0:0.28" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             From="1.22" To="1" Duration="0:0:0.28" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <!-- Countdown reached zero: say GO! / GAME OVER instead of vanishing -->
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="Content" Value="{Binding CompletionText}" />
                                <Setter Property="FontSize" Value="120" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             From="1.3" To="1" Duration="0:0:0.35" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             From="1.3" To="1" Duration="0:0:0.35" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
            </Viewbox>
        </StackPanel>
    </Border>
</Window>
